  "catalogUnits": {
    "cores": "count",
    "threads": "count",
    "tdp": "W",
    "process": "nm",
    "die": "mm2",
    "transistors": "million transistors",
    "smp": "sockets",
    "memory": "GB (legacy convention; GB/GiB not independently verified)"
  },
  "catalogCaveats": [
    "Every numeric specification needs primary, product-specific verification before promotion to verified status.",
    "Legacy zero numeric specifications become null with a missing reason; original data/cloud files are unchanged.",
    "Die area may refer to one chiplet rather than a complete package. Do not multiply it by a manufacturing factor without checking the physical boundary.",
    "TDP is a thermal design specification, not a measurement of average electricity consumption."
  ],
  "models": {
    "processor": {
      "status": "illustrative-not-calibrated",
      "equation": "(die_mm2 * dieGwp + baseGwp) * nodeFactor * packagingFactor * count",
      "factorRefs": [
        "semiconductors-factors.json#cpu.dieGwp",
        "cpus-factors.json#cpu.baseGwp",
        "cpus-factors.json#processorPackaging.cpu",
        "accelerators-factors.json#processorPackaging.gpu",
        "accelerators-factors.json#processorPackaging.gpu_consumer"
      ],
      "technologyFile": "semiconductors.json",
      "boundary": "Die and packaging proxy only. Verify total die versus chiplet area before applying to a catalog product. Accelerator memory, board and cooling are not inferred. Whole-card inventories replace this proxy."
    },
    "memory": {
      "status": "illustrative-not-calibrated",
      "equation": "(capacity_GB_per_module / density_GB_per_cm2 * dieGwp + baseGwp) * packagingFactor * moduleCount",
      "technologyFile": "memories.json",
      "boundary": "Factors are selected through the memory technology reference. cm2, not mm2."
    },
    "storage": {
      "status": "historical-proxy-not-revalidated",
      "equation": "SSD: capacity_GB_per_drive / density_GB_per_cm2 * dieGwp + baseGwp; HDD: hddGwp per drive",
      "technologyFile": "storages.json"
    },
    "display": {
      "status": "illustrative-not-calibrated",
      "equation": "area_cm2 * gwpPerCm2 + baseGwp",
      "technologyFile": "screens.json"
    },
    "battery": {
      "status": "illustrative-not-calibrated",
      "equation": "capacity_Wh / 1000 * gwpPerKwh",
      "technologyFile": "batteries.json"
    },
    "component-assembly": {
      "status": "fictional-configurations-not-product-inventories",
      "modelRefs": [
        "manifest.json#models.processor",
        "manifest.json#models.memory",
        "manifest.json#models.storage",
        "manifest.json#models.display",
        "manifest.json#models.battery"
      ],
      "factorFiles": [
        "devices-factors.json",
        "mobiles-factors.json",
        "tablets-factors.json",
        "laptops-factors.json",
        "servers-factors.json"
      ],
      "boundary": "Select only factors applicable to the configuration and component counts. These example configurations are not manufacturer inventories. Storage is GB for terminals, TB for servers."
    },
    "ai-profile": {
      "status": "illustrative-historical-profiles-not-calibrated",
      "boundary": "Scenario-specific aggregate manufacturing and power proxies. Follow factorRefs on the server scenario; do not add a second die, HBM, card or component-assembly estimate. Enclosure is a separate host allowance. These identifiers do not certify marketed configurations."
    }
  },
